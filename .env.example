DATABASE_URL="file:./dev.db"

# Single-user secure mode.
# Administrator initialization uses a separate protected .env.admin file.
AUTH_SECRET="CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES"
SESSION_TTL_HOURS="8"

# Secure Excel import limits and local private storage.
IMPORT_MAX_FILE_SIZE_MB="10"
IMPORT_MAX_ROWS="10000"
IMPORT_MAX_COLUMNS="100"
IMPORT_MAX_SHEETS="5"
IMPORT_STORAGE_PATH="./storage/imports"
IMPORT_RETENTION_DAYS="30"

# Reports engine: local private storage, retention and generation limits.
REPORT_STORAGE_PATH="./storage/reports"
REPORT_RETENTION_DAYS="90"
REPORT_MAX_ROWS="10000"
REPORT_MAX_FILE_SIZE_MB="25"

# Secret required by POST /api/internal/reports/run-due (the local scheduler
# script). Never reuse AUTH_SECRET. Not tied to the admin session cookie.
INTERNAL_SCHEDULER_SECRET="CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES"

# Encrypts the opaque drillthrough token used by the repeat-complainant
# directory (Analytics) so a complainant's raw identifier never appears in a
# URL, browser history, or log line. Never reuse AUTH_SECRET.
COMPLAINANT_TOKEN_SECRET="CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES"

# ─── Governed AI (Phase 8) ────────────────────────────────────────────────────
# AI is DISABLED by default. Set AI_ENABLED=true and provide a valid key to enable.
# The system works fully without AI — it is optional and can always be disabled.
AI_ENABLED="false"
AI_PROVIDER="openai"
AI_MODEL="gpt-4o-mini"
# Optional model override for historical classification; falls back to AI_MODEL.
AI_CLASSIFICATION_MODEL=""
AI_MAX_INPUT_COMPLAINTS="500"
AI_MAX_INPUT_CHARS="120000"
AI_REQUEST_TIMEOUT_SECONDS="60"
AI_RETENTION_DAYS="90"
AI_DAILY_RUN_LIMIT="20"

# Required only when AI_ENABLED=true. Never commit real keys.
# Placeholder values (CHANGE_ME, etc.) are rejected at startup when AI is enabled.
OPENAI_API_KEY=""

# ─── Backup ───────────────────────────────────────────────────────────────────
BACKUP_PATH="./backups"
BACKUP_RETENTION_DAYS="30"
