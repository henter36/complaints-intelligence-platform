DATABASE_URL="file:./dev.db"

# Single-user secure mode.
# Administrator initialization uses a separate protected .env.admin file.
AUTH_SECRET="CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES"
SESSION_TTL_HOURS="8"

# Secure Excel import limits and local private storage.
IMPORT_MAX_FILE_SIZE_MB="10"
IMPORT_MAX_ROWS="10000"
IMPORT_MAX_COLUMNS="100"
IMPORT_MAX_SHEETS="5"
IMPORT_STORAGE_PATH="./storage/imports"
IMPORT_RETENTION_DAYS="30"

# Reports engine: local private storage, retention and generation limits.
REPORT_STORAGE_PATH="./storage/reports"
REPORT_RETENTION_DAYS="90"
REPORT_MAX_ROWS="10000"
REPORT_MAX_FILE_SIZE_MB="25"

# Secret required by POST /api/internal/reports/run-due (the local scheduler
# script). Never reuse AUTH_SECRET. Not tied to the admin session cookie.
INTERNAL_SCHEDULER_SECRET="CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES"

# Optional. Governed AI is not enabled in the foundation phase.
OPENAI_API_KEY="CHANGE_ME"
