// Complaints Intelligence Platform - Phase 2 data model

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ComplaintStatus {
  NEW
  OPEN
  IN_PROGRESS
  AWAITING_RESPONSE
  RESOLVED
  CLOSED
  CANCELLED
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ImportBatchStatus {
  UPLOADED
  PARSING
  VALIDATED
  READY_FOR_CONFIRMATION
  CONFIRMING
  CONFIRMED
  FAILED
  ROLLING_BACK
  ROLLED_BACK
}

enum ImportRowAction {
  NEW
  UPDATE
  DUPLICATE
  REJECT
  NO_CHANGE
}

enum ImportRowValidationStatus {
  PENDING
  VALID
  WARNING
  INVALID
}

enum ImportChangeType {
  CREATE
  UPDATE
}

enum PeriodType {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum ReportType {
  EXECUTIVE_SUMMARY
  DEPARTMENT_PERFORMANCE
  REGION_FACILITY_PERFORMANCE
  CLASSIFICATION_ANALYSIS
  COMPLAINT_DETAIL
  OVERDUE_COMPLAINTS
}

enum ReportFormat {
  PDF
  XLSX
}

enum ReportRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ReportFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

model Category {
  id              String           @id @default(cuid())
  nameAr          String           @unique
  nameEn          String?
  description     String?
  displayOrder    Int              @default(0)
  isActive        Boolean          @default(true)
  isDeleted       Boolean          @default(false)
  deletedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  classifications Classification[]
  complaints      Complaint[]

  @@index([isActive, isDeleted])
  @@index([displayOrder])
}

model Classification {
  id           String      @id @default(cuid())
  categoryId   String
  category     Category    @relation(fields: [categoryId], references: [id])
  nameAr       String
  nameEn       String?
  description  String?
  color        String      @default("#64748b")
  keywords     Json?
  displayOrder Int         @default(0)
  isActive     Boolean     @default(true)
  isDeleted    Boolean     @default(false)
  deletedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  complaints   Complaint[]

  @@unique([categoryId, nameAr])
  @@index([categoryId])
  @@index([isActive, isDeleted])
  @@index([displayOrder])
}

model Complaint {
  id                    String                   @id @default(cuid())
  externalId            String?                  @unique
  sourceReference       String?
  complaintDate         DateTime?
  receivedAt            DateTime                 @default(now())
  dueDate               DateTime?
  closedAt              DateTime?
  status                ComplaintStatus          @default(NEW)
  subject               String
  description           String?
  complainantName       String?
  complainantIdentifier String?
  complainantPhone      String?
  region                String?
  facility              String?
  department            String?
  categoryId            String?
  category              Category?                @relation(fields: [categoryId], references: [id])
  classificationId      String?
  classification        Classification?          @relation(fields: [classificationId], references: [id])
  classificationAssignmentSource     String?
  classificationAssignedAt           DateTime?
  classificationAssignedBy           String?
  classificationTaxonomyFingerprint  String?
  classificationAssignmentRunId      String?
  priority              ComplaintPriority        @default(MEDIUM)
  severity              ComplaintPriority        @default(MEDIUM)
  channel               String?
  resolution            String?
  actionTaken           String?
  actionDescription     String?
  sourceClosedBy        String?
  wingCode              String?
  sourceUpdatedAt       DateTime?
  sourceModifiedAt      DateTime?
  sourceUpdatedBy       String?
  sourceOrigin          String?
  sourceStatus          String?
  sourceDetail          String?
  sourceActionStatus    String?
  firstActionAt         DateTime?
  processingStartedAt   DateTime?
  delayReason           String?
  isRepeated            Boolean                  @default(false)
  isValidated           Boolean                  @default(false)
  beneficiarySatisfaction Int?
  aiClassification      String?
  aiConfidence          Float?
  aiReasoning           String?
  aiSentiment           String?
  aiSeverityScore       Float?
  aiSummary             String?
  aiAnalyzedAt          DateTime?
  isPotentialDuplicate  Boolean                  @default(false)
  duplicateOfId         String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  version               Int                      @default(1)
  isDeleted             Boolean                  @default(false)
  deletedAt             DateTime?
  importBatchId         String?
  importBatch           ImportBatch?             @relation(fields: [importBatchId], references: [id])
  statusHistory         ComplaintStatusHistory[]
  matchedImportRows     ImportBatchRow[]         @relation("MatchedComplaintRows")
  createdImportRows     ImportBatchRow[]         @relation("CreatedComplaintRows")
  textRiskSignals       TextRiskSignal[]

  @@index([sourceReference])
  @@index([status])
  @@index([dueDate])
  @@index([createdAt])
  @@index([isDeleted])
  @@index([region])
  @@index([department])
  @@index([classificationId])
  @@index([classificationAssignmentSource])
  @@index([classificationAssignmentRunId])
  @@index([sourceReference, complaintDate])
}

model ClassificationBackfillRun {
  id                   String   @id @default(cuid())
  operation            String
  status               String
  periodFrom           DateTime
  periodToExclusive    DateTime
  taxonomyFingerprint  String
  manifestHash         String
  eligibleCount        Int      @default(0)
  plannedCount         Int      @default(0)
  appliedCount         Int      @default(0)
  skippedCount         Int      @default(0)
  failedCount          Int      @default(0)
  batchSize            Int      @default(500)
  actor                String
  startedAt            DateTime @default(now())
  completedAt          DateTime?
  rollbackOfRunId      String?
  failureCode          String?
  failureMessage       String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  items                ClassificationBackfillItem[]

  @@index([status])
  @@index([manifestHash])
  @@index([rollbackOfRunId])
  @@index([startedAt])
}

model ClassificationBackfillItem {
  id                              String    @id @default(cuid())
  runId                           String
  run                             ClassificationBackfillRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  complaintId                     String
  expectedVersion                 Int
  appliedVersion                  Int?
  previousClassificationId        String?
  previousCategoryId              String?
  targetClassificationId          String
  targetCategoryId                String?
  targetClassificationNameSnapshot String
  previousAssignmentSource        String?
  targetAssignmentSource          String
  previousAssignedAt              DateTime?
  previousAssignedBy              String?
  previousTaxonomyFingerprint     String?
  previousAssignmentRunId         String?
  sourceDetailHash                String
  result                          String
  skipReason                      String?
  appliedAt                       DateTime?
  rolledBackAt                    DateTime?
  createdAt                       DateTime  @default(now())
  updatedAt                       DateTime  @updatedAt

  @@unique([runId, complaintId])
  @@index([runId])
  @@index([complaintId])
  @@index([result])
  @@index([targetClassificationId])
}

model ComplaintStatusHistory {
  id            String           @id @default(cuid())
  complaintId   String
  complaint     Complaint        @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  fromStatus    ComplaintStatus?
  toStatus      ComplaintStatus
  changedAt     DateTime         @default(now())
  changedBy     String           @default("system")
  reason        String?
  importBatchId String?
  importBatch   ImportBatch?     @relation(fields: [importBatchId], references: [id])

  @@index([complaintId])
  @@index([importBatchId])
}

model ImportBatch {
  id              String              @id @default(cuid())
  fileName        String
  originalFileName String
  fileHash        String
  fileSize        Int
  mimeType        String?
  periodType      PeriodType
  periodStart     DateTime
  periodEnd       DateTime
  status          ImportBatchStatus   @default(UPLOADED)
  totalRows       Int                 @default(0)
  validRows       Int                 @default(0)
  invalidRows     Int                 @default(0)
  newRows         Int                 @default(0)
  updatedRows     Int                 @default(0)
  duplicateRows   Int                 @default(0)
  rejectedRows    Int                 @default(0)
  warningRows      Int                 @default(0)
  noChangeRows     Int                 @default(0)
  uploadedAt      DateTime            @default(now())
  validatedAt     DateTime?
  confirmedAt     DateTime?
  rolledBackAt    DateTime?
  processingStartedAt DateTime?
  processingCompletedAt DateTime?
  createdBy       String              @default("single-admin")
  notes           String?
  failureCode     String?
  storageKey      String?
  selectedSheet   String?
  columnMapping   Json?
  confirmationFailureCode String?
  rollbackFailureCode String?
  rollbackReason  String?
  appliedCreatedRows Int                 @default(0)
  appliedUpdatedRows Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  complaints      Complaint[]
  rows            ImportBatchRow[]
  statusHistory   ComplaintStatusHistory[]
  changeSnapshots ImportChangeSnapshot[]

  @@index([fileHash])
  @@index([status])
  @@index([createdAt])
  @@index([storageKey])
}

model ImportBatchRow {
  id                String                    @id @default(cuid())
  importBatchId     String
  importBatch       ImportBatch               @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  rowNumber         Int
  rawData           Json
  normalizedData    Json?
  externalId        String?
  action            ImportRowAction           @default(NEW)
  validationStatus  ImportRowValidationStatus @default(PENDING)
  validationErrors  Json?
  validationWarnings Json?
  matchedComplaintId String?
  matchedComplaint  Complaint?                @relation("MatchedComplaintRows", fields: [matchedComplaintId], references: [id])
  matchedComplaintVersion Int?
  createdComplaintId String?
  createdComplaint  Complaint?                @relation("CreatedComplaintRows", fields: [createdComplaintId], references: [id])
  appliedAt         DateTime?
  rolledBackAt      DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  changeSnapshots   ImportChangeSnapshot[]

  @@unique([importBatchId, rowNumber])
  @@index([importBatchId])
  @@index([matchedComplaintId])
  @@index([createdComplaintId])
  @@index([externalId])
  @@index([action])
  @@index([validationStatus])
  @@index([appliedAt])
}

model ImportChangeSnapshot {
  id               String           @id @default(cuid())
  importBatchId    String
  importBatch      ImportBatch      @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  importBatchRowId String
  importBatchRow   ImportBatchRow   @relation(fields: [importBatchRowId], references: [id], onDelete: Cascade)
  complaintId      String
  changeType       ImportChangeType
  beforeData       Json?
  afterData        Json
  versionBefore    Int?
  versionAfter     Int
  createdAt        DateTime         @default(now())

  @@unique([importBatchRowId])
  @@index([importBatchId])
  @@index([complaintId])
  @@index([changeType])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String?
  actor      String   @default("system")
  occurredAt DateTime @default(now())
  metadata   Json?

  @@index([entityType, entityId])
  @@index([action])
  @@index([occurredAt])
}

model AdminCredential {
  id                String   @id @default(cuid())
  singletonKey      String   @default("single-admin") @unique
  username          String   @unique
  passwordHash      String
  passwordChangedAt DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AdminSession {
  id            String    @id @default(cuid())
  tokenHash     String    @unique
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  lastSeenAt    DateTime  @default(now())
  revokedAt     DateTime?
  ipHash        String?
  userAgentHash String?

  @@index([expiresAt])
  @@index([revokedAt])
}

model LoginAttempt {
  id             String   @id @default(cuid())
  identifierHash String
  ipHash         String?
  succeeded      Boolean  @default(false)
  attemptedAt    DateTime @default(now())

  @@index([identifierHash])
  @@index([attemptedAt])
  @@index([identifierHash, attemptedAt])
}

model ReportTemplate {
  id          String           @id @default(cuid())
  name        String
  description String?
  reportType  ReportType
  filters     Json
  options     Json
  isActive    Boolean          @default(true)
  createdBy   String           @default("single-admin")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  lastRunAt   DateTime?
  schedules   ReportSchedule[]
  runs        ReportRun[]

  @@index([isActive])
  @@index([reportType])
}

model ReportSchedule {
  id               String          @id @default(cuid())
  reportTemplateId String
  reportTemplate   ReportTemplate  @relation(fields: [reportTemplateId], references: [id], onDelete: Cascade)
  frequency        ReportFrequency
  timeOfDay        String
  dayOfWeek        Int?
  dayOfMonth       Int?
  timezone         String          @default("Asia/Riyadh")
  isEnabled        Boolean         @default(true)
  nextRunAt        DateTime
  lastRunAt        DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([isEnabled])
  @@index([nextRunAt])
  @@index([reportTemplateId])
}

model ReportRun {
  id               String           @id @default(cuid())
  reportTemplateId String?
  reportTemplate   ReportTemplate?  @relation(fields: [reportTemplateId], references: [id])
  reportType       ReportType
  status           ReportRunStatus  @default(PENDING)
  requestedBy      String           @default("single-admin")
  scheduledFor     DateTime?
  idempotencyKey   String?          @unique
  startedAt        DateTime?
  completedAt      DateTime?
  failedAt         DateTime?
  filtersSnapshot  Json
  optionsSnapshot  Json
  resultSummary    Json?
  errorCode        String?
  errorMessage     String?
  createdAt        DateTime         @default(now())
  artifacts        ReportArtifact[]

  @@index([status])
  @@index([createdAt])
  @@index([reportTemplateId])
}

model ReportArtifact {
  id           String       @id @default(cuid())
  reportRunId  String
  reportRun    ReportRun    @relation(fields: [reportRunId], references: [id], onDelete: Cascade)
  format       ReportFormat
  storageKey   String
  fileName     String
  mimeType     String
  fileSize     Int
  sha256       String
  createdAt    DateTime     @default(now())
  expiresAt    DateTime
  deletedAt    DateTime?

  @@index([reportRunId])
  @@index([expiresAt])
  @@index([deletedAt])
}

// ─── Phase 9: Text Risk Rule Engine ─────────────────────────────────────────

enum TextRiskSignalType {
  SERVICE_OUTAGE
  PROCEDURE_FAILURE
  PUBLIC_HEALTH
  POISONING
  SENTENCE_EXPIRY
  LEGAL_DELAY
  SECURITY_INCIDENT
  MEDICATION_SHORTAGE
  FOOD_OR_WATER_SAFETY
  INFRASTRUCTURE_FAILURE
}

enum TextRiskDetectionSource {
  RULE
}

enum TextRiskReviewStatus {
  PENDING_REVIEW
  CONFIRMED
  DISMISSED
  DUPLICATE
  NEEDS_MORE_DATA
}

enum TextRiskCertainty {
  CONFIRMED_IN_TEXT
  SUSPECTED
  ALLEGED
  HISTORICAL_RESOLVED
  UNCLEAR
}

enum TextRiskScanStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model TextRiskSignal {
  id                     String                  @id @default(cuid())
  complaintId            String
  complaint              Complaint               @relation(fields: [complaintId], references: [id])
  signalType             TextRiskSignalType
  ruleId                 String
  ruleVersion            String
  title                  String
  description            String
  severity               ComplaintPriority
  severityRank           Int                     @default(0)
  confidenceScore        Float
  certainty              TextRiskCertainty
  isOngoing              Boolean?
  evidenceSpans          Json
  normalizedEvidenceHash String
  sourceTextHash         String
  detectedBy             TextRiskDetectionSource @default(RULE)
  reviewStatus           TextRiskReviewStatus    @default(PENDING_REVIEW)
  region                 String?
  facility               String?
  department             String?
  reviewedBy             String?
  reviewedAt             DateTime?
  reviewReason           String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@unique([complaintId, ruleId, ruleVersion, normalizedEvidenceHash])
  @@index([complaintId])
  @@index([signalType])
  @@index([severity])
  @@index([reviewStatus])
  @@index([ruleVersion])
  @@index([createdAt])
  @@index([region])
  @@index([facility])
  @@index([department])
  @@index([severityRank, createdAt])
}

model TextRiskScanRun {
  id                  String             @id @default(cuid())
  status              TextRiskScanStatus @default(PENDING)
  ruleVersion         String
  importBatchId       String?
  totalComplaints     Int                @default(0)
  processedComplaints Int                @default(0)
  matchedSignals      Int                @default(0)
  lastComplaintId     String?
  startedAt           DateTime?
  completedAt         DateTime?
  failedAt            DateTime?
  errorCode           String?
  errorMessage        String?
  activeLockKey       String?            @unique
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([status])
  @@index([importBatchId])
  @@index([ruleVersion])
  @@index([createdAt])
}

// ─── Phase 8: Governed AI ───────────────────────────────────────────────────

enum AiAnalysisType {
  EXECUTIVE_SUMMARY
  RECURRING_TOPICS
  POSSIBLE_ROOT_CAUSES
  ANOMALY_ANALYSIS
  IMPROVEMENT_OPPORTUNITIES
}

enum AiRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model AiAnalysisRun {
  id                  String         @id @default(cuid())
  analysisType        AiAnalysisType
  status              AiRunStatus    @default(PENDING)
  requestedBy         String         @default("single-admin")
  filtersSnapshot     Json
  inputSummary        Json
  model               String?
  provider            String?
  promptVersion       String?
  startedAt           DateTime?
  completedAt         DateTime?
  failedAt            DateTime?
  errorCode           String?
  errorMessage        String?
  createdAt           DateTime       @default(now())
  expiresAt           DateTime?
  result              AiAnalysisResult?
  feedbacks           AiFeedback[]

  @@index([status])
  @@index([analysisType])
  @@index([createdAt])
  @@index([expiresAt])
}

model AiAnalysisResult {
  id            String         @id @default(cuid())
  analysisRunId String         @unique
  analysisRun   AiAnalysisRun  @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  resultJson    Json
  resultText    String?
  createdAt     DateTime       @default(now())
  deletedAt     DateTime?

  @@index([deletedAt])
}

model AiFeedback {
  id            String         @id @default(cuid())
  analysisRunId String
  analysisRun   AiAnalysisRun  @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  rating        String
  comment       String?
  createdAt     DateTime       @default(now())

  @@index([analysisRunId])
}

model ClassificationTaxonomyRestructureRun {
  id                              String   @id @default(cuid())
  operation                       String
  status                          String
  proposalHash                    String
  mappingHash                     String
  currentTaxonomyFingerprint      String
  targetTaxonomyFingerprint       String
  manifestHash                    String
  actor                           String
  startedAt                       DateTime @default(now())
  completedAt                     DateTime?
  createdCount                    Int      @default(0)
  renamedCount                    Int      @default(0)
  movedCount                      Int      @default(0)
  deactivatedCount                Int      @default(0)
  keywordChangeCount              Int      @default(0)
  legacyComplaintConsistencyUpdateCount Int @default(0)
  failureCode                     String?
  failureMessage                  String?
  rollbackOfRunId                 String?
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt
  items                           ClassificationTaxonomyRestructureItem[]

  @@index([status])
  @@index([manifestHash])
  @@index([proposalHash])
  @@index([rollbackOfRunId])
}

model ClassificationTaxonomyRestructureItem {
  id                String   @id @default(cuid())
  runId             String
  run               ClassificationTaxonomyRestructureRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  entityType        String
  action            String
  entityId          String?
  previousStateJson Json?
  nextStateJson     Json?
  result            String
  skipReason        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([runId])
  @@index([entityType])
  @@index([action])
  @@index([result])
}
