// Complaints Intelligence Platform - Phase 2 data model

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ComplaintStatus {
  NEW
  OPEN
  IN_PROGRESS
  AWAITING_RESPONSE
  RESOLVED
  CLOSED
  CANCELLED
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ImportBatchStatus {
  UPLOADED
  PARSING
  VALIDATED
  READY_FOR_CONFIRMATION
  CONFIRMING
  CONFIRMED
  FAILED
  ROLLED_BACK
}

enum ImportRowAction {
  NEW
  UPDATE
  DUPLICATE
  REJECT
  NO_CHANGE
}

enum ImportRowValidationStatus {
  PENDING
  VALID
  WARNING
  INVALID
}

enum PeriodType {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

model Category {
  id              String           @id @default(cuid())
  nameAr          String           @unique
  nameEn          String?
  description     String?
  displayOrder    Int              @default(0)
  isActive        Boolean          @default(true)
  isDeleted       Boolean          @default(false)
  deletedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  classifications Classification[]
  complaints      Complaint[]

  @@index([isActive, isDeleted])
  @@index([displayOrder])
}

model Classification {
  id           String      @id @default(cuid())
  categoryId   String
  category     Category    @relation(fields: [categoryId], references: [id])
  nameAr       String
  nameEn       String?
  description  String?
  color        String      @default("#64748b")
  keywords     Json?
  displayOrder Int         @default(0)
  isActive     Boolean     @default(true)
  isDeleted    Boolean     @default(false)
  deletedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  complaints   Complaint[]

  @@unique([categoryId, nameAr])
  @@index([categoryId])
  @@index([isActive, isDeleted])
  @@index([displayOrder])
}

model Complaint {
  id                    String                   @id @default(cuid())
  externalId            String?                  @unique
  sourceReference       String?
  complaintDate         DateTime?
  receivedAt            DateTime                 @default(now())
  dueDate               DateTime?
  closedAt              DateTime?
  status                ComplaintStatus          @default(NEW)
  subject               String
  description           String?
  complainantName       String?
  complainantIdentifier String?
  complainantPhone      String?
  region                String?
  facility              String?
  department            String?
  categoryId            String?
  category              Category?                @relation(fields: [categoryId], references: [id])
  classificationId      String?
  classification        Classification?          @relation(fields: [classificationId], references: [id])
  priority              ComplaintPriority        @default(MEDIUM)
  severity              ComplaintPriority        @default(MEDIUM)
  channel               String?
  resolution            String?
  firstActionAt         DateTime?
  processingStartedAt   DateTime?
  delayReason           String?
  isRepeated            Boolean                  @default(false)
  isValidated           Boolean                  @default(false)
  beneficiarySatisfaction Int?
  aiClassification      String?
  aiConfidence          Float?
  aiReasoning           String?
  aiSentiment           String?
  aiSeverityScore       Float?
  aiSummary             String?
  aiAnalyzedAt          DateTime?
  isPotentialDuplicate  Boolean                  @default(false)
  duplicateOfId         String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  version               Int                      @default(1)
  isDeleted             Boolean                  @default(false)
  deletedAt             DateTime?
  importBatchId         String?
  importBatch           ImportBatch?             @relation(fields: [importBatchId], references: [id])
  statusHistory         ComplaintStatusHistory[]
  matchedImportRows     ImportBatchRow[]         @relation("MatchedComplaintRows")
  createdImportRows     ImportBatchRow[]         @relation("CreatedComplaintRows")

  @@index([sourceReference])
  @@index([status])
  @@index([dueDate])
  @@index([createdAt])
  @@index([isDeleted])
  @@index([region])
  @@index([department])
  @@index([classificationId])
  @@index([sourceReference, complaintDate])
}

model ComplaintStatusHistory {
  id            String           @id @default(cuid())
  complaintId   String
  complaint     Complaint        @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  fromStatus    ComplaintStatus?
  toStatus      ComplaintStatus
  changedAt     DateTime         @default(now())
  changedBy     String           @default("system")
  reason        String?
  importBatchId String?
  importBatch   ImportBatch?     @relation(fields: [importBatchId], references: [id])

  @@index([complaintId])
  @@index([importBatchId])
}

model ImportBatch {
  id              String              @id @default(cuid())
  fileName        String
  originalFileName String
  fileHash        String
  fileSize        Int
  mimeType        String?
  periodType      PeriodType
  periodStart     DateTime
  periodEnd       DateTime
  status          ImportBatchStatus   @default(UPLOADED)
  totalRows       Int                 @default(0)
  validRows       Int                 @default(0)
  invalidRows     Int                 @default(0)
  newRows         Int                 @default(0)
  updatedRows     Int                 @default(0)
  duplicateRows   Int                 @default(0)
  rejectedRows    Int                 @default(0)
  uploadedAt      DateTime            @default(now())
  validatedAt     DateTime?
  confirmedAt     DateTime?
  rolledBackAt    DateTime?
  createdBy       String              @default("single-admin")
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  complaints      Complaint[]
  rows            ImportBatchRow[]
  statusHistory   ComplaintStatusHistory[]

  @@index([fileHash])
  @@index([status])
  @@index([createdAt])
}

model ImportBatchRow {
  id                String                    @id @default(cuid())
  importBatchId     String
  importBatch       ImportBatch               @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  rowNumber         Int
  rawData           Json
  normalizedData    Json?
  externalId        String?
  action            ImportRowAction           @default(NEW)
  validationStatus  ImportRowValidationStatus @default(PENDING)
  validationErrors  Json?
  validationWarnings Json?
  matchedComplaintId String?
  matchedComplaint  Complaint?                @relation("MatchedComplaintRows", fields: [matchedComplaintId], references: [id])
  createdComplaintId String?
  createdComplaint  Complaint?                @relation("CreatedComplaintRows", fields: [createdComplaintId], references: [id])
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@unique([importBatchId, rowNumber])
  @@index([importBatchId])
  @@index([matchedComplaintId])
  @@index([createdComplaintId])
  @@index([externalId])
  @@index([action])
  @@index([validationStatus])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String?
  actor      String   @default("system")
  occurredAt DateTime @default(now())
  metadata   Json?

  @@index([entityType, entityId])
  @@index([action])
  @@index([occurredAt])
}

model AdminCredential {
  id                String   @id @default(cuid())
  singletonKey      String   @default("single-admin") @unique
  username          String   @unique
  passwordHash      String
  passwordChangedAt DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AdminSession {
  id            String    @id @default(cuid())
  tokenHash     String    @unique
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  lastSeenAt    DateTime  @default(now())
  revokedAt     DateTime?
  ipHash        String?
  userAgentHash String?

  @@index([expiresAt])
  @@index([revokedAt])
}

model LoginAttempt {
  id             String   @id @default(cuid())
  identifierHash String
  ipHash         String?
  succeeded      Boolean  @default(false)
  attemptedAt    DateTime @default(now())

  @@index([identifierHash])
  @@index([attemptedAt])
  @@index([identifierHash, attemptedAt])
}

model ReportTemplate {
  id        String   @id @default(cuid())
  name      String
  type      String
  config    Json
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
