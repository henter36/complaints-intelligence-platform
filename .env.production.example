# Production environment configuration.
# Copy to .env and fill in all values before starting.
# NEVER commit .env to git.

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="file:/opt/complaints-platform/data/database.sqlite"

# ─── Auth ──────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
AUTH_SECRET="<generated-32-byte-hex>"
SESSION_TTL_HOURS="8"

# ─── Scheduler ────────────────────────────────────────────────────────────────
# Generate separately from AUTH_SECRET: openssl rand -hex 32
INTERNAL_SCHEDULER_SECRET="<generated-32-byte-hex>"

# ─── Import ────────────────────────────────────────────────────────────────────
IMPORT_MAX_FILE_SIZE_MB="10"
IMPORT_MAX_ROWS="10000"
IMPORT_MAX_COLUMNS="100"
IMPORT_MAX_SHEETS="5"
IMPORT_STORAGE_PATH="/opt/complaints-platform/storage/imports"
IMPORT_RETENTION_DAYS="30"

# ─── Reports ───────────────────────────────────────────────────────────────────
REPORT_STORAGE_PATH="/opt/complaints-platform/storage/reports"
REPORT_RETENTION_DAYS="90"
REPORT_MAX_ROWS="10000"
REPORT_MAX_FILE_SIZE_MB="25"

# ─── AI (disabled by default) ─────────────────────────────────────────────────
AI_ENABLED="false"
AI_PROVIDER="openai"
AI_MODEL="gpt-4o-mini"
AI_MAX_INPUT_COMPLAINTS="500"
AI_MAX_INPUT_CHARS="120000"
AI_REQUEST_TIMEOUT_SECONDS="60"
AI_RETENTION_DAYS="90"
AI_DAILY_RUN_LIMIT="20"
# Only required when AI_ENABLED=true:
OPENAI_API_KEY=""

# ─── Backup ────────────────────────────────────────────────────────────────────
BACKUP_PATH="/opt/complaints-platform/backups"
BACKUP_RETENTION_DAYS="30"
